# --- Gemini ---
GEMINI_API_KEY=your_key_here
# Default is a known ID. The docs now list newer Flash models; copy the exact ID from
# https://ai.google.dev/gemini-api/docs/models and test audio input before relying on it.
GEMINI_MODEL=gemini-2.5-flash
LLM_MOCK=false            # true = offline keyword extraction + template explanations

# --- Routing / geocoding ---
USE_OSRM=true
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=crisis-command-hackathon (your-email@example.com)

# --- Demo city ---
DEMO_CITY_NAME=Tiruchirappalli
DEMO_CENTER_LAT=10.8050
DEMO_CENTER_LNG=78.6856
DEMO_BBOX=10.72,78.60,10.90,78.78     # south,west,north,east

# --- Solver / simulation ---
TARGET_RESPONSE_MIN=10
SWITCH_PENALTY=0.15
AVG_SPEED_KMPH=40
SIM_SPEED=30              # 1 real second = 30 simulated seconds for animation

# --- Server ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info